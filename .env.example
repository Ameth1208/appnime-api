NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://appnime:appnime@localhost:5432/appnime?schema=public
JWT_ACCESS_SECRET=change-me-access-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PAYMENT_GRACE_HOURS=48
OFFLINE_GRACE_HOURS=72
LEASE_REFRESH_AFTER_HOURS=6
USAGE_SESSION_STALE_SECONDS=180
DEVICE_LINK_TTL_SECONDS=600
INVITATION_TTL_HOURS=168
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
INITIAL_ADMIN_EMAIL=admin@appnime.com
INITIAL_ADMIN_PASSWORD=Admin123456!
INITIAL_USER_EMAIL=user@appnime.com
INITIAL_USER_PASSWORD=User123456!
